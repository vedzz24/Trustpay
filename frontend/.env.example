# Optional backend origin override. Leave blank during local/LAN development to
# automatically use http://<current-browser-host>:5000.
# http://localhost:5173 -> http://localhost:5000
# http://192.168.29.237:5173 -> http://192.168.29.237:5000
VITE_API_URL=

# Optional public app origin override for permanent merchant QR codes. Leave
# blank to use the origin currently open in the browser.
VITE_PUBLIC_APP_URL=
VITE_GOOGLE_CLIENT_ID=
