NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
TRUSTPAY_SECRET=

# Comma-separated hosted web origins. Capacitor origins and local Vite origins
# are handled by the server's explicit allow-list.
# In production on Render, set:
# CORS_ORIGINS=https://trustpay-gamma.vercel.app
CORS_ORIGINS=http://localhost:5173,https://trustpay-gamma.vercel.app
FRONTEND_URL=https://trustpay-gamma.vercel.app

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── EMAIL CONFIGURATION ────────────────────────────────────────────────────────
# IMPORTANT CLOUD NOTICE:
# Render Free Web Services BLOCK outbound traffic on SMTP ports 25, 465, and 587.
# When deploying to Render Free Tier, do NOT use SMTP with port 587/465 because
# it will time out. Use an HTTP API provider instead:
#
# Option 1: Resend (HTTP API - Port 443, works on Render)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=GuardX <onboarding@resend.dev>  # or verified domain address
#
# Option 2: Brevo / Sendinblue (HTTP API - Port 443, works on Render, 300 free emails/day)
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-xxxxxxxxx
# EMAIL_FROM=TrustPay <trustpayservices25@gmail.com>
#
# Option 3: SMTP (Local development or paid Render tiers with unblocked ports)
# EMAIL_PROVIDER=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_16_char_google_app_password
# EMAIL_FROM=TrustPay <your_email@gmail.com>

EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_HASH_SECRET=
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
