NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
TRUSTPAY_SECRET=

# Comma-separated hosted web origins. Capacitor origins and local Vite origins
# are handled by the server's explicit allow-list.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production: resend. Optional local alternative: smtp.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_HASH_SECRET=
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
