MONGO_URI=mongodb://127.0.0.1:27017
JWT_SECRET=replace-with-a-long-random-value
PORT=5000
# Comma-separated explicit origins. Required for browser access in production.
# Development also accepts localhost and private-LAN origins on Vite port 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay Test Mode credentials (backend only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP confirmation email (backend only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=TrustPay <no-reply@example.com>
PUBLIC_APP_URL=http://localhost:5173

# Google Identity Services (same OAuth Web client ID as the frontend)
GOOGLE_CLIENT_ID=

# Secure phone OTP delivery via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_HASH_SECRET=replace-with-a-long-random-value
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
